---
import { getImage } from 'astro:assets';

import PageTitle from '../../foundation/components/PageTitle/PageTitle.astro';
import CommonLayout from '../../foundation/layouts/CommonLayout/CommonLayout.astro';
import PageLayout from '../../foundation/layouts/PageLayout/PageLayout.astro';
import { processImageForWorkCard } from '../../context/work/services';

import { WorkCardList } from './_internal/WorkCardList/WorkCardList';
import { getManyWork } from '../../context/work/repository';

const works = await getManyWork();

const workCards = await Promise.all(works.map((work) => processImageForWorkCard({ work, processor: getImage })));
---

<CommonLayout>
	<PageTitle title="works" />
	<PageLayout>
		<WorkCardList client:load workCards={workCards} />
	</PageLayout>
</CommonLayout>
