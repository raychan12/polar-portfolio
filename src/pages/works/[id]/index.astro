---
import { fileToUrl } from '@chlorinec-pkgs/notion-astro-loader';
import type { GetStaticPaths } from 'astro';

import type { Work } from '../../../context/work/definitions';

import { getCollection, render } from 'astro:content';
import { convertCollectionToWork } from '../../../context/work/services';
import type { RenderResult } from 'astro:content';
import PageTitle from '../../../foundation/components/PageTitle/PageTitle.astro';
import CommonLayout from '../../../foundation/layouts/CommonLayout/CommonLayout.astro';
import PageLayout from '../../../foundation/layouts/PageLayout/PageLayout.astro';
import WorkLayout from '../../../foundation/layouts/WorkLayout/WorkLayout.astro';
import WorkDescriptions from './_internal/WorkDescriptions/WorkDescriptions.astro';
import { processImageForThumbnailGallery } from './_internal/services';
import { ThumbnailGallery } from './_internal/ThumbnailGallery/ThumbnailGallery';
import BackButton from './_internal/BackButton/BackButton.astro';

export const getStaticPaths = (async () => {
	const worksCollectionEntries = await getCollection('works');
	return await Promise.all(
		worksCollectionEntries.map(async (entry) => {
			const {
				['ロゴ画像']: logoImages,
				['サムネイル画像']: thumbnailImages,
				...propsWithoutImages
			} = entry.data.properties;
			const logoImageFile = logoImages.files.at(0);
			if (logoImageFile == null) {
				throw new Error(`Expected to have at least one logo image for work '${propsWithoutImages.Slug}'`);
			}
			const logoUrl = fileToUrl(logoImageFile);
			const visualImageUrl = thumbnailImages.files.map((file) => fileToUrl(file));

			const work = convertCollectionToWork({ propsWithoutImages, logoUrl, visualImageUrl });

			return {
				params: { id: work.id },
				props: { rendered: await render(entry), work },
			};
		}),
	);
}) satisfies GetStaticPaths;

interface Props {
	rendered: RenderResult;
	work: Work;
}

const { rendered, work } = Astro.props;

const galleryProps = await processImageForThumbnailGallery(work);
---

<CommonLayout>
	<PageTitle title="works" />
	<PageLayout>
		<WorkLayout>
			<ThumbnailGallery client:load {...galleryProps} />
			<WorkDescriptions {work} {rendered} />
			<BackButton />
		</WorkLayout>
	</PageLayout>
</CommonLayout>
