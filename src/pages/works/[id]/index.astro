---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { RenderResult } from 'astro:content';

import { processImageForThumbnailGallery } from '../../../context/work/services';
import { getManyWork } from '../../../context/work/repository';
import type { Work } from '../../../context/work/definitions';
import PageTitle from '../../../foundation/components/PageTitle/PageTitle.astro';
import CommonLayout from '../../../foundation/layouts/CommonLayout/CommonLayout.astro';
import PageLayout from '../../../foundation/layouts/PageLayout/PageLayout.astro';
import WorkLayout from '../../../foundation/layouts/WorkLayout/WorkLayout.astro';
import WorkDescriptions from './_internal/WorkDescriptions/WorkDescriptions.astro';
import { ThumbnailGallery } from './_internal/ThumbnailGallery/ThumbnailGallery';
import BackButton from './_internal/BackButton/BackButton.astro';

export const getStaticPaths = (async () => {
	const works = await getManyWork();
	const worksCollection = await getCollection('works');
	const worksCollectionMap = new Map(worksCollection.map((work) => [work.data.properties.Slug, work]));

	return await Promise.all(
		works.map(async (work) => {
			const collection = worksCollectionMap.get(work.id);
			if (collection == null) {
				throw new Error(`Work collection not found: ${work.id}`);
			}

			return {
				params: { id: work.id },
				props: { work, rendered: await render(collection) },
			};
		}),
	);
}) satisfies GetStaticPaths;

interface Props {
	work: Work;
	rendered: RenderResult;
}

const { work, rendered } = Astro.props;

const galleryProps = await processImageForThumbnailGallery({ work, processor: getImage });
---

<CommonLayout>
	<PageTitle title="works" />
	<PageLayout>
		<WorkLayout>
			<ThumbnailGallery client:load {...galleryProps} />
			<WorkDescriptions {work} {rendered} />
			<BackButton />
		</WorkLayout>
	</PageLayout>
</CommonLayout>
